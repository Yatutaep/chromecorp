{
  "schemaVersion": 1,
  "id": "chromecorp",
  "version": "${version}",
  "name": "Chrome & Corp",
  "description": "Антиутопичный киберпанк: мегакорпорации, био-лизинг, хром и киберпсихоз.",
  "authors": [
    "You"
  ],
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.chromecorp.ChromeCorp"
    ],
    "client": [
      "com.chromecorp.client.ChromeCorpClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  },
  "mixins": [
    {
      "config": "chromecorp.mixins.json",
      "environment": "client"
    }
  ]
}